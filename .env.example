# Vouch Environment Configuration

# Payment Provider: 'mock' (default for Day 1 development) or 'paypal_sandbox'
PAYMENT_PROVIDER=mock

# PayPal Sandbox Credentials (fill in your .env, NEVER commit .env)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_RECEIVER_EMAIL=facilitator_business_account@sandbox.paypal.com

# LLM Provider & Model Configuration
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database URL (Day 1 requirement: local Docker Postgres or Neon/Render cloud)
DATABASE_URL=postgresql+asyncpg://vouch_user:vouch_password@localhost:5432/vouch_db

# App Settings
PORT=8000
ENVIRONMENT=development
JWT_SECRET=vouch_hackathon_super_secret_jwt_key_32_bytes_min
UPLOAD_DIR=./uploads
