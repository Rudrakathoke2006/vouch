# Vouch Environment Configuration

# Payment Provider: 'paypal_sandbox' or 'mock'
PAYMENT_PROVIDER=paypal_sandbox

# PayPal Sandbox Credentials (from developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_RECEIVER_EMAIL=facilitator_business_account@sandbox.paypal.com

# LLM Provider Configuration (gemini or mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
# PostgreSQL connection string, or sqlite+aiosqlite:///./vouch.db for instant zero-dependency testing
DATABASE_URL=sqlite+aiosqlite:///./vouch.db

# App Settings
PORT=8000
ENVIRONMENT=development
JWT_SECRET=vouch_hackathon_super_secret_jwt_key_32_bytes_min
UPLOAD_DIR=./uploads
